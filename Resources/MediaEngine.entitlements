<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of the media engine (Contents/XPCServices/com.snappycrew.frenzy.worker.xpc/Contents/Helpers/frenzy-media-engine).

  App Sandbox + inherit is how macOS lets a helper run under its parent's sandbox: the engine gets the worker's profile
  exactly, so no network and no writes outside the worker's container. It has no sandbox of its own to widen, and macOS
  stops it at launch if it is started by anything that isn't sandboxed.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
</dict>
</plist>
